{
  "intent_envelope": "0.1",
  "id": "refund-desk",
  "revision": 4,
  "purpose": "Issue refunds of up to 500 dollars on orders the customer can see, and tell the customer by email.",
  "principal": {
    "agent_identity": "refund-desk-agent",
    "on_behalf_of": "support.refunds_team"
  },
  "tools": {
    "allow": [
      {
        "name": "orders_read"
      },
      {
        "name": "issue_refund",
        "constraints": {
          "max_amount_usd": 500
        }
      },
      {
        "name": "send_email",
        "constraints": {
          "template": "refund_confirmation"
        }
      },
      {
        "name": "summarise"
      },
      {
        "name": "fetch_url"
      }
    ],
    "deny": [
      "customer_export"
    ]
  },
  "data": {
    "allow": [
      "orders:read",
      "customers:read:own"
    ],
    "deny": [
      "payments.card_numbers"
    ],
    "processors": [
      "anthropic",
      "internal-gpu"
    ]
  },
  "egress": {
    "allow": [
      "api.payments.example.com",
      ".example.com"
    ],
    "deny": [
      "169.254.0.0/16",
      "metadata.google.internal",
      "10.0.0.0/8"
    ]
  },
  "credentials": {
    "bind": "task",
    "max_lifetime_seconds": 900
  },
  "amendment": {
    "approvers": [
      {
        "id": "dana@example.com",
        "public_key": "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAGb9ECWmEzf6FQbrBZ9w7lshQhqowtrbLDFw4rXAxZuE=\n-----END PUBLIC KEY-----\n"
      }
    ],
    "protected_tools": [
      "update_envelope",
      "edit_policy"
    ]
  },
  "components": {
    "require_manifest": true
  },
  "recipients": {
    "allow": [
      "@customers.example.com"
    ],
    "max_per_run": 1
  },
  "limits": {
    "max_tool_calls": 20,
    "max_spend_usd": 3.0
  },
  "escalate": [
    {
      "when": "amount_usd > 200",
      "to": "refunds-duty-lead",
      "timeout_seconds": 1800
    }
  ],
  "on_no_response": "deny",
  "expires": "2027-06-30T23:59:59Z"
}