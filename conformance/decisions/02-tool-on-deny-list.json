{
  "name": "deny wins even when the tool is also allowed",
  "spec_rule": 2,
  "decided_by": "tools.deny",
  "envelope": {
    "intent_envelope": "0.1",
    "id": "invoice-reconciler",
    "revision": 3,
    "purpose": "Reconcile this month's supplier invoices against the ledger and flag mismatches for a human.",
    "principal": {
      "agent_identity": "invoice-reconciler",
      "on_behalf_of": "finance.ap_team"
    },
    "tools": {
      "allow": [
        {
          "name": "http_request"
        },
        {
          "name": "ledger_search"
        }
      ],
      "deny": [
        "http_request"
      ]
    },
    "data": {
      "allow": [
        "ledger:read:current_month",
        "invoices:read"
      ],
      "deny": [
        "payroll",
        "bank.credentials"
      ]
    },
    "recipients": {
      "allow": [
        "ap-team@example.com"
      ],
      "max_per_run": 3
    },
    "limits": {
      "max_tool_calls": 20,
      "max_records": 500,
      "max_spend_usd": 2.0,
      "max_runtime_seconds": 300
    },
    "escalate": [
      {
        "when": "mismatch_value_gbp > 10000",
        "to": "ap-duty-controller",
        "timeout_seconds": 3600
      }
    ],
    "on_no_response": "deny",
    "expires": "2027-06-30T23:59:59Z"
  },
  "call": {
    "tool": "http_request",
    "arguments": {
      "url": "https://example.com"
    },
    "data": [],
    "recipients": []
  },
  "state": {
    "now": "2026-11-02T12:00:00Z",
    "tool_calls_made": 0,
    "records_returned": 0,
    "spend_usd": 0.0,
    "runtime_seconds": 10,
    "recipients_contacted": 0
  },
  "note": "http_request appears in both lists. Section 3 step 2 says deny always wins.",
  "expect": {
    "result": "deny",
    "rule": "tools.deny"
  }
}
