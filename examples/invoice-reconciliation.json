{
  "intent_envelope": "0.1",
  "id": "invoice-reconciliation",
  "revision": 4,
  "purpose": "Reconcile this month's supplier invoices against purchase orders and write a summary for the AP team.",
  "principal": { "agent_identity": "invoice-agent", "on_behalf_of": "accounts-payable" },
  "tools": {
    "allow": [
      { "name": "read_file", "constraints": { "path_prefix": ["/invoices/current-month/", "/purchase-orders/"] } },
      { "name": "write_summary", "constraints": { "path_prefix": ["/reports/reconciliation/"] } }
    ],
    "deny": ["send_email", "http_request", "issue_payment"]
  },
  "data": {
    "allow": ["erp.invoices:read", "erp.purchase_orders:read"],
    "deny": ["erp.bank_details", "hr.*"]
  },
  "limits": { "max_tool_calls": 400, "max_records": 5000, "max_spend_usd": 20, "max_runtime_seconds": 1800 },
  "escalate": [
    { "when": "mismatch_amount_usd > 1000", "to": "ap-manager", "timeout_seconds": 86400 }
  ],
  "expires": "2026-12-31T23:59:59Z",
  "on_no_response": "deny"
}
